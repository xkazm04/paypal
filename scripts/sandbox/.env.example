# Copy to scripts/sandbox/.env.sandbox (gitignored via .env.*) and fill from
# developer.paypal.com > Apps & Credentials > Sandbox. Never commit real values.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET=
# Sandbox BUSINESS account's merchant (payer) ID, the payee of test orders
PAYPAL_SANDBOX_MERCHANT_ID=
# Sandbox business email that receives invoices (spike 8)
PAYPAL_SANDBOX_INVOICE_EMAIL=
# Spike 9 only: merchant ID of a SECOND sandbox business account (a different payee than the one above)
PAYPAL_SANDBOX_OTHER_MERCHANT_ID=
